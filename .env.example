# Copy this file to .env and fill in your AWS values.
# .env is gitignored; .env.example is committed as a template.

AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-1
ARTIFACTS_BUCKET=cfn-artifacts-us-east1-123456789012
STACK_NAME=elden-ring-agent

# Set after Phase 3 (KB created in Bedrock console)
KB_ID=KB_ID_GOES_HERE

# Set after Phase 1 deploy (from CloudFormation outputs)
API_ENDPOINT=https://YOUR_API_ID.execute-api.us-east-1.amazonaws.com/prod
WEBSITE_URL=https://YOUR_CLOUDFRONT_URL.cloudfront.net
KB_DOCS_BUCKET=elden-ring-kb-docs-123456789012
WEB_BUCKET=elden-ring-web-123456789012

# Phase 0 data extraction paths.
# NOTE: use forward slashes so bash `source` doesn't eat the backslashes.
WITCHYBND_EXE=C:/path/to/WitchyBND/WitchyBND.exe
MSB_DIR=C:/path/to/WitchyBND/mapstudio
