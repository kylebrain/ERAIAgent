# Copy this file to .env and fill in your AWS values.
# .env is gitignored; .env.example is committed as a template.

# Prefix every line with `export` so `source .env` puts these in the
# environment (not just shell-local) for Python/AWS CLI child processes.

export AWS_ACCOUNT_ID=123456789012
export AWS_REGION=us-east-1
export ARTIFACTS_BUCKET=cfn-artifacts-us-east1-123456789012
export STACK_NAME=elden-ring-agent

# Set after Phase 3 (KB created in Bedrock console)
export KB_ID=KB_ID_GOES_HERE

# Set after Phase 1 deploy (from CloudFormation outputs)
export API_ENDPOINT=https://YOUR_API_ID.execute-api.us-east-1.amazonaws.com/prod
export WEBSITE_URL=https://YOUR_CLOUDFRONT_URL.cloudfront.net
export KB_DOCS_BUCKET=elden-ring-kb-docs-123456789012
export WEB_BUCKET=elden-ring-web-123456789012

# Optional: set so scripts/deploy_web.sh invalidates the CloudFront cache
# automatically after uploading. Find it with:
#   aws cloudfront list-distributions --query \
#     "DistributionList.Items[?DomainName=='YOUR.cloudfront.net'].Id" --output text
export CLOUDFRONT_DISTRIBUTION_ID=YOUR_DISTRIBUTION_ID

# Optional: ACM certificate ARN for eldenring.kylebrain.com (must be in us-east-1).
# Request with: aws acm request-certificate --domain-name eldenring.kylebrain.com \
#   --validation-method DNS --region us-east-1
# Then validate via CNAME in Namecheap, wait for ISSUED status, and redeploy.
export ACM_CERT_ARN=arn:aws:acm:us-east-1:123456789012:certificate/YOUR_CERTIFICATE_ID

# Optional: WAF Web ACL ARN. Required if the distribution has a Shield/WAF subscription.
# Find with: aws cloudfront get-distribution-config --id YOUR_DIST_ID \
#   --query "DistributionConfig.WebACLId" --output text
export WEB_ACL_ARN=arn:aws:wafv2:us-east-1:123456789012:global/webacl/YOUR_WEB_ACL_NAME/YOUR_WEB_ACL_ID

# Phase 0 data extraction paths.
# NOTE: use forward slashes so bash `source` doesn't eat the backslashes.
export WITCHYBND_EXE=C:/path/to/WitchyBND/WitchyBND.exe
export MSB_DIR=C:/path/to/WitchyBND/mapstudio

export ANTHROPIC_API_KEY=your_anthropic_api_key_goes_here
export ASSEMBLYAI_API_KEY=your_assemblyai_api_key_goes_here
